# Flask backend environment. Copy to .env and fill in real values.
# PostgreSQL connection string for the existing Supabase Postgres database.
# SQLAlchemy 2.x requires the postgresql:// scheme (not postgres://).
DATABASE_URL=postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres

# Secret used to sign JWTs. Generate a long random string.
JWT_SECRET_KEY=change-me-to-a-long-random-string

# Flask session/secret key.
SECRET_KEY=change-me-to-another-long-random-string

# Comma-separated list of allowed frontend origins (CORS).
CORS_ORIGINS=http://localhost:5173

# Set to 1 to echo SQL to stdout (debug only).
SQLALCHEMY_ECHO=0

# M-Pesa Daraja (STK Push). Get your own sandbox Consumer Key/Secret at
# https://developer.safaricom.co.ke (free account, separate from these values).
# MPESA_SHORTCODE and MPESA_PASSKEY below are Safaricom's public sandbox
# test app and work out of the box once you supply your own key/secret.
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379
MPESA_PASSKEY=bfb279f9aa9bdbcf158e97dd71a467cd2e0c893059b10f78e6b72ada1ed2c919
# Safaricom must be able to reach this URL from the internet — use ngrok
# (or similar) for local development, e.g. https://<id>.ngrok.io/api/payments/mpesa/callback
MPESA_CALLBACK_URL=http://localhost:5000/api/payments/mpesa/callback
